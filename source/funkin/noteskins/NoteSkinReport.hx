package funkin.noteskins;

import sys.io.File;
import haxe.io.Path;

/**
 * Conversion report for a single imported noteskin. Written as a plain-text
 * file under `assets/noteskins/reports/<id>.txt` (overwritten on each import,
 * so conversion stays repeatable) and echoed to the log.
 */
@:nullSafety
class NoteSkinReport
{
  var id:String;
  var displayName:String;
  var sourceDir:String;
  var atlasSource:String; // 'sparrow-xml' | 'texturepacker-json' | ...
  public var kind:String = 'unknown';
  public var issues:Array<SkinCompatibility.SkinIssue> = [];
  public var notes:Array<String> = [];
  public var frameCount:Int = 0;
  public var paletteMask:Bool = false;

  public function new(id:String, displayName:String, sourceDir:String, atlasSource:String)
  {
    this.id = id;
    this.displayName = displayName;
    this.sourceDir = sourceDir;
    this.atlasSource = atlasSource;
  }

  public function addIssue(level:String, area:String, message:String):Void
  {
    issues.push(({level: level, area: area, message: message} : SkinCompatibility.SkinIssue));
  }

  public function note(message:String):Void
  {
    notes.push(message);
  }

  public function errorCount():Int
  {
    var n = 0;
    for (i in issues) if (i.level == 'error') n++;
    return n;
  }

  public function warnCount():Int
  {
    var n = 0;
    for (i in issues) if (i.level == 'warn') n++;
    return n;
  }

  public function toText():String
  {
    var out = new StringBuf();
    out.add('Noteskin conversion report\n');
    out.add('==========================\n\n');
    out.add('Skin:       ${displayName} (${id})\n');
    out.add('Source:     ${sourceDir}\n');
    out.add('Atlas:      ${atlasSource} (${frameCount} frames)\n');
    out.add('Detected:   ${kind}${paletteMask ? " (RGB channel-mask — palette baked)" : ""}\n\n');

    if (notes.length > 0)
    {
      out.add('Actions:\n');
      for (n in notes) out.add('  - ${n}\n');
      out.add('\n');
    }

    if (issues.length == 0)
    {
      out.add('No issues — all conventional frames resolved.\n');
    }
    else
    {
      out.add('Issues (${errorCount()} errors, ${warnCount()} warnings, ${issues.length - errorCount() - warnCount()} info):\n\n');
      for (line in SkinCompatibility.formatIssues(issues)) out.add(line + '\n');
    }
    out.add('\nGenerated by R-Slice noteskin importer. Source files were not modified.\n');
    return out.toString();
  }

  /** Write the report next to the generated skin assets. */
  public function write(gameDir:String):Null<String>
  {
    var dir:String = Path.join([gameDir, NoteSkinImporter.ATLAS_OUT_DIR, '..', 'reports']);
    dir = Path.normalize(dir);
    try
    {
      if (!sys.FileSystem.exists(dir))
      {
        var parent = Path.directory(dir);
        if (!sys.FileSystem.exists(parent)) sys.FileSystem.createDirectory(parent);
        sys.FileSystem.createDirectory(dir);
      }
      var file = Path.join([dir, id + '.txt']);
      File.saveContent(file, toText());
      return file;
    }
    catch (e:Dynamic)
    {
      return null;
    }
  }
}
