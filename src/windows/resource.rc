// Application icons for raide.exe.
//  - IDI_ICON1: exe icon used by Explorer, taskbar fallback and ExtractIcon.
//  - "GLFW_ICON": named resource the GLFW Win32 backend loads for the window
//    class icon (window title bar + taskbar while running). Without it GLFW
//    falls back to IDI_APPLICATION, which renders as a blank/generic icon.
#include <windows.h>

// NOTE: windres (MinGW) misparses a quoted-name ICON statement that follows
// another ICON entry, so the string-named resource must come first. rc.exe
// accepts any order.
"GLFW_ICON" ICON "../../assets/icon.ico"
IDI_ICON1 ICON "../../assets/icon.ico"
